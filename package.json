{
  "name": "n8n-nodes-iobroker",
  "version": "0.6.0",
  "description": "Community nodes for n8n  to integrate ioBroker into your workflows.",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/oweitman/n8n-nodes-iobroker",
  "author": {
    "name": "oweitman",
    "email": "oweitman@gmx.de"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oweitman/n8n-nodes-iobroker.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "rimraf dist && tsc && gulp build:icons && npm run bundle:socket",
    "bundle:socket": "esbuild ./dist/nodes/Iobroker/IoBrokerRead.node.js ./dist/nodes/Iobroker/IoBrokerOutput.node.js ./dist/nodes/Iobroker/IoBrokerTrigger.node.js ./dist/nodes/Iobroker/iobrokerConnection.js --bundle --platform=node --format=cjs --sourcemap --outbase=dist --outdir=dist --external:n8n-workflow --external:@iobroker/types --external:ws --allow-overwrite",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -- --config eslint.config.prepublish.js",
    "test": "npm run build && node --test test/*.test.js",
    "start": "npx n8n start"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/IoBrokerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Iobroker/IoBrokerRead.node.js",
      "dist/nodes/Iobroker/IoBrokerOutput.node.js",
      "dist/nodes/Iobroker/IoBrokerTrigger.node.js"
    ]
  },
  "bundledDependencies": [
    "@iobroker/socket-client-backend"
  ],
  "devDependencies": {
    "@iobroker/socket-client-backend": "file:../socket-client/backend",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/parser": "^8.66.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "gulp": "^5.0.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "@iobroker/types": "^7.2.2",
    "ws": "^8.21.3"
  },
  "bundleDependencies": [
    "@iobroker/socket-client-backend"
  ]
}
